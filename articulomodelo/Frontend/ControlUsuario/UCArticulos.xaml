<UserControl x:Class="articulomodelo.Frontend.ControlUsuario.UCArticulos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:articulomodelo.Frontend.ControlUsuario"
        mc:Ignorable="d"
               xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        Loaded="usuario_listaArticulos_Loaded"
        d:DesignHeight="450" d:DesignWidth="800">
    
    
    <DockPanel>
        <Grid DockPanel.Dock="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <Border BorderThickness="2" Grid.Row="0" BorderBrush="Black" Width="550" Height="80" Margin="0,10" Background="CornflowerBlue">
                <TextBlock Text="Lista Articulos" FontSize="30"  TextAlignment="Center" Margin="0,20"
                    Width="550" FontWeight="DemiBold" Foreground="White" Height="80"/>
            </Border>
            <!--Filtros-->
            <Border Background="White" Grid.Row="1">
                <StackPanel Orientation="Horizontal" Margin="10" VerticalAlignment="Center">

                    <!--Inicio-->
                    <TextBlock Text="Fecha Inicial" FontWeight="Bold" FontSize="15"/>
                    <DatePicker SelectedDate="{Binding FechaAltaDesde, UpdateSourceTrigger=PropertyChanged}" Margin="10,0,0,0" Width="150"/>

                    <!--Final-->
                    <TextBlock Text="Fecha Final" FontWeight="Bold" FontSize="15" Margin="50,0,0,0"/>
                    <DatePicker SelectedDate="{Binding FechaAltaHasta, UpdateSourceTrigger=PropertyChanged}" Margin="10,0,0,0" Width="150"/>
                    <!--Boton-->
                    <Button Background="BlueViolet" FontSize="15" Foreground="White" Width="100" Content="FILTRAR" FontWeight="Bold" Margin="30,0,0,0"
                            Click="Filtrar_Click"/>
                    <Button Background="Blue" FontSize="12" Foreground="White" Width="100" FontWeight="Bold" Margin="20,0,0,0" Click="Limpiar_Click">
                        <TextBlock TextWrapping="Wrap">LIMPIAR FILTROS</TextBlock>
                    </Button>
                </StackPanel>
            </Border>
            <Border Background="White" Grid.Row="2">
                <StackPanel Orientation="Horizontal" Margin="10" VerticalAlignment="Center">
                    
                    <!--FILTRO NUMESRIE-->
                    <TextBlock Text="Nº Serie" FontSize="15" FontWeight="Bold"/>
                    <TextBox Text="{Binding NumSerieFiltro}" Width="150"
                             Margin="10,0,0,0" />
                    
                    <!--FILTRO COMBOBOX-->
                    <TextBlock Text="Espacio" FontSize="15" FontWeight="Bold" Margin="80,0,0,0"/>
                    <ComboBox ItemsSource="{Binding listaEspacios}"
                    SelectedItem="{Binding espacioSeleccionado}"  DisplayMemberPath="Nombre"
                       mah:TextBoxHelper.Watermark="Selecciona un espacio" Width="150" Margin="20,0,0,0"/>
                    
                    <!--SLIDER-->
                </StackPanel>
            </Border>
        </Grid>
        <Grid>
            <DataGrid ItemsSource="{Binding listaArticulos_CollectionView}" AutoGenerateColumns="False"
              CanUserAddRows="False" ColumnWidth="*" Background="AntiqueWhite" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NÚMERO DE SERIE" Binding="{Binding Numserie}"/>
                    <DataGridTextColumn Header="MODELO" Binding="{Binding ModeloNavigation.Nombre}"/>
                    <DataGridTextColumn Header="ESTADO" Binding="{Binding Estado}"/>
                    <DataGridTextColumn Header="ESPACIO" Binding="{Binding tipoEspacioSeleccionado.Nombre}"/>
                    <DataGridTextColumn Header="USUARIO ALTA" Binding="{Binding UsuarioaltaNavigation.Username, StringFormat=d}"/>
                    <DataGridTextColumn Header="FECHA ALTA" Binding="{Binding Fechaalta}"/>
                    <DataGridTextColumn Header="FECHA FINAL" Binding="{Binding Fechabaja}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        
    </DockPanel>
</UserControl>
