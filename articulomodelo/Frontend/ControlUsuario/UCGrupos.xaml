<UserControl x:Class="articulomodelo.Frontend.ControlUsuario.UCGrupos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:articulomodelo.Frontend.ControlUsuario"
               xmlns:entidades="clr-namespace:articulomodelo.Backend.Modelo"
                xmlns:mat="http://materialdesigninxaml.net/winfx/xaml/themes"
               Loaded="ucGrupo_Loaded"
        mc:Ignorable="d"
        d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <DockPanel>
            <Grid DockPanel.Dock="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border BorderThickness="2" BorderBrush="Black" Width="550" Height="80" Margin="0,10" Background="CornflowerBlue" Grid.Row="0">
                    <TextBlock Text="Lista Grupos" FontSize="30"  TextAlignment="Center" Margin="0,20" 
Width="550" FontWeight="DemiBold" Foreground="White" Height="80"/>
                </Border>
            </Grid>
        </DockPanel>
        <Grid>
            <TreeView ItemsSource="{Binding listaGrupos}">
                <TreeView.Resources>
                    <!--NIVEL 1: Mostrar nombre de Grupos-->
                    <HierarchicalDataTemplate DataType="{x:Type entidades:Grupo}"
                                              ItemsSource="{Binding Usuarios}">
                        <StackPanel Orientation="Horizontal">
                            <mat:PackIcon Kind="Group" Width="16"/>
                            <TextBlock Margin="10,0,0,0">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} ({1})">
                                        <Binding Path="Nombre"/>
                                        <Binding Path="Usuarios.Count"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                    <!--NIVEL 2: Mostar usuarios-->
                    <HierarchicalDataTemplate DataType="{x:Type entidades:Usuario}"
                                              ItemsSource="{Binding Salida}">

                        <StackPanel Orientation="Horizontal">
                            <mat:PackIcon Kind="User" Width="16"/>
                            <TextBlock>
                                <TextBlock.Text>
                                    <!--Pasar a Texto Plano | Username | Nombre | Apellido 1-->
                                    <MultiBinding StringFormat="{} {0} {1} {2}">
                                        <Binding Path="Username"/>
                                        <Binding Path="Nombre"/>
                                        <Binding Path="Apellido1"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </HierarchicalDataTemplate>
            <!--NIVEL 3: Mostar salidas-->
                    <HierarchicalDataTemplate DataType="{x:Type entidades:Salida}">
                        <StackPanel Orientation="Horizontal">
                            <mat:PackIcon Kind="ExitRun" Width="16"/>
                            <TextBlock Text="{Binding Fechasalida, StringFormat='dd/MM/yyyy'}"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.Resources>
            </TreeView>
        </Grid>
    </Grid>
</UserControl>
