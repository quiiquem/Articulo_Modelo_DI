<mah:MetroWindow x:Class="articulomodelo.Frontend.Dialogos.DialogoEspacio"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:articulomodelo.Frontend.Dialogos"
        mc:Ignorable="d"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:mat="http://materialdesigninxaml.net/winfx/xaml/themes"
        Loaded="dialogoEspacio_Loaded"
        Title="DialogoEspacio" Height="450" Width="800">
    <Grid>
        <Grid Margin="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- TITULO -->
                <Border BorderThickness="2" Grid.Row="0" BorderBrush="Black" Width="700" Grid.ColumnSpan="2"
                        Height="80" Margin="0,10" Background="CornflowerBlue">
                    <TextBlock Text="Insertar Espacio" FontSize="30" TextAlignment="Center" Margin="0,20"
                               Width="700" FontWeight="DemiBold" Foreground="White" Height="80"/>
                </Border>

                <!-- NOMBRE -->
                <TextBlock Foreground="Black" Text="Nombre (*)" Grid.Row="1" FontSize="15" FontWeight="Bold"
                           Margin="20,10"/>
                <TextBox x:Name="txtNombre"
                         Text="{Binding Espacio.Nombre, ValidatesOnDataErrors=True,
                             NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}"
                         FontWeight="Bold"
                         Grid.Row="2"
                         Grid.Column="0"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Center"
                         Width="250"
                         Height="40"
                         Margin="10"
                         Background="#FFFFEE"
                         BorderBrush="Black"
                         BorderThickness="2"/>

                <!-- DESCRIPCION -->
                <TextBlock Foreground="Black" Text="Descripción" Grid.Row="1" Grid.Column="1" FontSize="15" FontWeight="Bold"
                           Margin="20,10"/>
                <TextBox x:Name="txtDescripcion"
                         Text="{Binding Espacio.Descripcion, UpdateSourceTrigger=PropertyChanged}"
                         FontWeight="Bold"
                         Grid.Row="2"
                         Grid.Column="1"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Center"
                         Width="250"
                         Height="40"
                         Margin="10"
                         Background="#FFFFEE"
                         BorderBrush="Black"
                         BorderThickness="2"/>

                <!-- ESPACIO PADRE -->
                <TextBlock Foreground="Black" Text="Espacio Padre" Grid.Row="3" FontSize="15" FontWeight="Bold"
                           Margin="20,10"/>
                <ComboBox
                    mat:HintAssist.Hint="Espacio Padre"
                    FontWeight="Bold"
                    Grid.Row="4"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Width="250"
                    Height="40"
                    Margin="10,5"
                    BorderBrush="Black"
                    x:Name="cmbEspacioPadre"
                    ItemsSource="{Binding listaEspacios}"
                    SelectedItem="{Binding Espacio.PadreNavigation, UpdateSourceTrigger=PropertyChanged}"
                    DisplayMemberPath="Nombre"/>

                <!-- BOTONES -->
                <Button
                    Grid.Row="5"
                    Grid.Column="0"
                    Content="Cancelar"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="Red"
                    Foreground="White"
                    FontSize="30"
                    FontWeight="Bold"
                    Width="200"
                    Height="50"
                    Margin="10"
                    x:Name="btnCancelarEspacio"
                    Click="btnCancelarEspacio_Click"/>

                <Button
                    Grid.Row="5"
                    Grid.Column="1"
                    Content="Guardar"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="Blue"
                    Foreground="White"
                    FontSize="30"
                    FontWeight="Bold"
                    Width="200"
                    Height="50"
                    Margin="10"
                    x:Name="btnGuardarEspacio"
                    Click="btnGuardarEspacio_Click"/>
            </Grid>
        </Grid>
    </Grid>
</mah:MetroWindow>